<Window x:Class="Dijkstra.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dijkstra.Desktop"
        mc:Ignorable="d"
        Title="Visualizador de Rutas Dijkstra" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo: configuración parametrizada de la red -->
        <ScrollViewer Grid.Column="0" Background="#F3F3F6" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="Configuración de la red" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="1. Generar una red aleatoria" FontWeight="SemiBold"/>
                <TextBlock Text="Demuestra que la cantidad de puntos es totalmente configurable en tiempo de ejecución." FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Puntos:" VerticalAlignment="Center"/>
                    <TextBox x:Name="RandomPointCountBox" Width="50" Margin="8,0,0,0" Text="8"/>
                    <Button x:Name="GenerateRandomButton" Content="Generar" Margin="8,0,0,0" Padding="8,2" Click="GenerateRandomButton_Click"/>
                </StackPanel>

                <Separator Margin="0,0,0,12"/>

                <TextBlock Text="2. O construirla manualmente" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <TextBlock Text="Id del punto" FontSize="11" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <TextBox x:Name="NewPointIdBox" Width="190"/>
                    <Button Content="Agregar punto" Width="80" Margin="8,0,0,0" Click="AddPointButton_Click"/>
                </StackPanel>

                <TextBlock Text="Conexión" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Desde" Width="55" VerticalAlignment="Center"/>
                    <ComboBox x:Name="FromCombo" Width="120"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Hasta" Width="55" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ToCombo" Width="120"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Peso" Width="55" VerticalAlignment="Center"/>
                    <TextBox x:Name="WeightBox" Width="120" Text="1"/>
                </StackPanel>
                <CheckBox x:Name="BidirectionalCheckBox" Content="Bidireccional" IsChecked="True" Margin="55,2,0,6"/>
                <Button Content="Agregar conexión" HorizontalAlignment="Left" Width="150" Click="AddConnectionButton_Click" Margin="0,0,0,12"/>

                <Separator Margin="0,0,0,12"/>

                <TextBlock Text="3. Calcular la ruta óptima" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Origen" Width="75" VerticalAlignment="Center"/>
                    <ComboBox x:Name="StartCombo" Width="190"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Destino" Width="75" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DestinationCombo" Width="190"/>
                </StackPanel>
                <Button Content="Calcular ruta óptima" FontWeight="Bold" Padding="4" Click="CalculateButton_Click" Margin="0,0,0,10"/>

                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,0,0,16">
                    <TextBlock x:Name="ResultText" Text="Todavía no se ha calculado ninguna ruta." TextWrapping="Wrap"/>
                </Border>

                <Separator Margin="0,0,0,12"/>

                <Button Content="Cargar red de ejemplo" Click="LoadSampleButton_Click" Margin="0,0,0,8"/>
                <Button Content="Limpiar red" Click="ClearButton_Click"/>

                <Separator Margin="0,16,0,8"/>
                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap">
                    <Run Text="Leyenda: "/>
                    <Run Text="verde" Foreground="SeaGreen" FontWeight="Bold"/>
                    <Run Text=" = origen, "/>
                    <Run Text="rojo" Foreground="IndianRed" FontWeight="Bold"/>
                    <Run Text=" = destino, "/>
                    <Run Text="naranja" Foreground="Orange" FontWeight="Bold"/>
                    <Run Text=" = parte de la ruta óptima."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Panel derecho: representación gráfica de la red -->
        <Border Grid.Column="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Margin="8">
            <Canvas x:Name="NetworkCanvas" Background="White" ClipToBounds="True" SizeChanged="NetworkCanvas_SizeChanged"/>
        </Border>
    </Grid>
</Window>
